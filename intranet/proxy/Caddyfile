# Proxy reverso do Lupa. Um unico origin HTTPS, tudo para o front Django (front:8000); a API nao
# e alcancavel pelo proxy (0.2, plano_front_django D2): o Django a chama pela rede `borda`.
# O cookie de sessao da API (Secure, SameSite=Strict, Path=/) passa pelo Django.
# O Caddy substitui o X-Forwarded-For recebido pelo IP real do cliente (nao confia em cabecalho
# vindo de fora); o Django o repassa a API, que confia nele so quando vem da rede `borda`.
#
# Certificado: so o modo interno (intranet/proxy/modos/interno.caddy), CA interna do Caddy com
# `tls internal` para localhost e proxy.
# Validacao: intranet/api/scripts/validar_caddyfile.sh (caddy validate em conteiner).
{
	admin off
	persist_config off
	skip_install_trust
	http_port 8080
	https_port 8443
}

# Cabecalhos e rotas do site.
(lupa_site) {
	encode gzip
	# Etapa 6.10: cabecalhos de seguranca (conferidos por intranet/api/scripts/verificar_cabecalhos.py e pelo
	# E2E de seguranca, que falham se faltar algum ou se a CSP afrouxar).
	# CSP (D10): nada inline e sem 'unsafe-hashes'; scripts e estilos so do proprio front.
	# HSTS: fica em intranet/proxy/modos/interno.caddy.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()"
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		X-Permitted-Cross-Domain-Policies none
		-Server
	}
	reverse_proxy front:8000
}

import modos/interno.caddy

# Saude do proprio proxy, so para o healthcheck do conteiner (porta nao publicada).
:8081 {
	respond /saude "ok" 200
}
