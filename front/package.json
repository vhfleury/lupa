{
  "name": "lupa-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/externalizar-inicio.mjs",
    "lint": "prettier --check . && eslint . --max-warnings 0",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "verificar": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write ."
  },
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@sveltejs/adapter-static": "3.0.8",
    "@sveltejs/kit": "2.15.1",
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/svelte": "5.2.6",
    "@types/qrcode": "1.5.5",
    "eslint": "9.17.0",
    "eslint-plugin-svelte": "2.46.1",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "picomatch": "4.0.2",
    "prettier": "3.4.2",
    "prettier-plugin-svelte": "3.3.2",
    "svelte": "5.16.0",
    "svelte-check": "4.1.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.0",
    "vite": "6.0.7",
    "vitest": "3.0.2"
  }
}
